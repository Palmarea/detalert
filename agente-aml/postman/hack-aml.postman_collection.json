{
  "info": {
    "name": "Hack AI Agents · AML",
    "description": "Colección para la demo: API de ML (scoring) y bandeja (ingest). Llena las variables ml_key e ingest_token en tu entorno de Postman; no las guardes en este archivo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ml_base",
      "value": "https://aml-scoring-api.vercel.app"
    },
    {
      "key": "ml_key",
      "value": ""
    },
    {
      "key": "bandeja_base",
      "value": "https://detalert.vercel.app"
    },
    {
      "key": "ingest_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 · ML: estado y modelo",
      "item": [
        {
          "name": "GET /health (sin key)",
          "request": {
            "method": "GET",
            "url": "{{ml_base}}/health"
          },
          "description": "Chequea que la API está viva."
        },
        {
          "name": "GET /thresholds",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ml_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ml_base}}/thresholds",
            "description": "Umbrales por modo: el espectro que el agente de aprendizaje propone mover."
          }
        },
        {
          "name": "GET /model/metrics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{ml_key}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ml_base}}/model/metrics",
            "description": "Gini, KS y embudo contra el baseline de reglas."
          }
        }
      ]
    },
    {
      "name": "2 · ML: puntuar en vivo (caso del jurado)",
      "item": [
        {
          "name": "POST /score/live · A lavado (≈ 0,997, high_priority)",
