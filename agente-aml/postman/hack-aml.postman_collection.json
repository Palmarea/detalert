              "raw": "{\n  \"ts\": \"2023-08-10T05:15:22Z\",\n  \"sender_account\": \"6812204903\",\n  \"receiver_account\": \"5440521221\",\n  \"amount\": 6248.44,\n  \"payment_type\": \"Cross-border\",\n  \"payment_currency\": \"UK pounds\",\n  \"received_currency\": \"Euro\"\n}",
