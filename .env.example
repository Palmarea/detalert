# Copia a .env (no se versiona) y completa. En Vercel: Project Settings -> Environment Variables.
AML_BACKEND=mock            # mock | postgres
DATABASE_URL=               # URL del pooler de Postgres (Neon/Supabase), solo con AML_BACKEND=postgres
AML_API_KEY=                # opcional: si se define, la API exige el header X-API-Key
AML_CORS_ORIGINS=*          # dominios del frontend separados por coma
