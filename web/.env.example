# Postgres (npm run db:up levanta uno local en el puerto 5433)
DATABASE_URL=postgres://monitor:monitor@localhost:5433/monitor

# Token que debe enviar la fuente de eventos a POST /api/ingest ("Authorization: Bearer <token>").
# En desarrollo, si se deja vacío, vale "dev-ingest-token". Obligatorio en producción.
INGEST_TOKEN=

# Intervalo de polling del navegador (ms)
NEXT_PUBLIC_EVENTS_POLL_MS=3000

# Secreto para firmar la cookie de sesión (obligatorio en producción).
# Generar con: openssl rand -base64 32
AUTH_SECRET=
